@using ProjetoHotelAviao.Models.ViewModels
@model AccountIndexViewModel
@{
    ViewData["Title"] = "My Account - TravelSys";
    var user = Model.User;
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/Account/account.css" asp-append-version="true">
}

<div class="container py-4">
    @Html.AntiForgeryToken()

    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="bg-primary text-white p-4 position-relative d-flex align-items-end justify-content-end" style="height: 180px;">
            <button class="btn btn-light btn-sm fw-semibold shadow-sm">
                <i class="fas fa-cloud-upload-alt me-1"></i> Upload new cover
            </button>
        </div>
        
        <div class="card-body p-4 pt-0">
            <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-end gap-3 mt-n5 position-relative">
                <div class="position-relative">
                    <img src="https://ui-avatars.com/api/?name=@(user.FirstName ?? user.UserName)&background=8DD3BB&color=fff&size=160" 
                         alt="Avatar" 
                         class="rounded-circle border border-4 border-white shadow" 
                         width="120" height="120">
                    <button class="btn btn-sm btn-light rounded-circle position-absolute bottom-0 end-0 border shadow-sm">
                        <i class="fas fa-pencil-alt"></i>
                    </button>
                </div>
                <div class="text-center text-sm-start mt-2">
                    <h1 class="h3 fw-bold mb-0">@(user.FirstName ?? "User") @(user.LastName ?? "")</h1>
                    <p class="text-muted mb-0">@user.Email</p>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-pills nav-fill mb-4 bg-white p-2 rounded shadow-sm border" id="accountTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "account" || ViewBag.ActiveTab == null ? "active" : "") fw-semibold" 
                    id="account-tab-btn" data-bs-toggle="tab" data-bs-target="#account-tab" type="button" role="tab">
                Account
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "bookings" ? "active" : "") fw-semibold" 
                    id="bookings-tab-btn" data-bs-toggle="tab" data-bs-target="#bookings-tab" type="button" role="tab">
                Tickets/Bookings
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(ViewBag.ActiveTab == "payments" ? "active" : "") fw-semibold" 
                    id="payments-tab-btn" data-bs-toggle="tab" data-bs-target="#payments-tab" type="button" role="tab">
                Payment methods
            </button>
        </li>
    </ul>

    <div class="tab-content" id="accountTabsContent">
        
        <div class="tab-pane fade @(ViewBag.ActiveTab == "account" || ViewBag.ActiveTab == null ? "show active" : "")" id="account-tab" role="tabpanel">
            <div class="card border-0 shadow-sm p-4">
                <h2 class="h4 fw-bold mb-4">Account</h2>

                <div class="d-flex flex-column gap-3">

]                    <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-light" data-field="name">
                        <div class="w-100 me-3">
                            <label class="form-label text-muted small mb-1 fw-bold">Name</label>
                            <div class="value-display fw-semibold">
                                @(string.IsNullOrEmpty(user.FirstName) ? "Not set" : user.FirstName) @(user.LastName ?? "")
                            </div>
                            <div class="edit-inputs d-none row g-2 mt-1">
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm first-name" value="@user.FirstName" placeholder="First Name">
                                </div>
                                <div class="col-6">
                                    <input type="text" class="form-control form-control-sm last-name" value="@user.LastName" placeholder="Last Name">
                                </div>
                            </div>
                        </div>
                        <div class="action-buttons-edit">
                            <button class="btn btn-outline-secondary btn-sm btn-change"><i class="fas fa-edit me-1"></i> Change</button>
                            <div class="edit-actions d-none d-flex gap-1">
                                <button class="btn btn-success btn-sm btn-save-inline">Save</button>
                                <button class="btn btn-outline-danger btn-sm btn-cancel-inline">Cancel</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-light" data-field="email">
                        <div class="w-100 me-3">
                            <label class="form-label text-muted small mb-1 fw-bold">Email</label>
                            <div class="value-display fw-semibold">@user.Email</div>
                            <div class="edit-inputs d-none mt-1">
                                <input type="email" class="form-control form-control-sm user-email" value="@user.Email" placeholder="New Email">
                            </div>
                        </div>
                        <div class="action-buttons-edit">
                            <button class="btn btn-outline-secondary btn-sm btn-change"><i class="fas fa-edit me-1"></i> Change</button>
                            <div class="edit-actions d-none d-flex gap-1">
                                <button class="btn btn-success btn-sm btn-save-inline">Save</button>
                                <button class="btn btn-outline-danger btn-sm btn-cancel-inline">Cancel</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-light" data-field="password">
                        <div class="w-100 me-3">
                            <label class="form-label text-muted small mb-1 fw-bold">Password</label>
                            <div class="value-display fw-semibold">************</div>
                            <div class="edit-inputs d-none row g-2 mt-1">
                                <div class="col-6">
                                    <input type="password" class="form-control form-control-sm current-password" placeholder="Current Password">
                                </div>
                                <div class="col-6">
                                    <input type="password" class="form-control form-control-sm new-password" placeholder="New Password">
                                </div>
                            </div>
                        </div>
                        <div class="action-buttons-edit">
                            <button class="btn btn-outline-secondary btn-sm btn-change"><i class="fas fa-edit me-1"></i> Change</button>
                            <div class="edit-actions d-none d-flex gap-1">
                                <button class="btn btn-success btn-sm btn-save-inline">Save</button>
                                <button class="btn btn-outline-danger btn-sm btn-cancel-inline">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(ViewBag.ActiveTab == "bookings" ? "show active" : "")" id="bookings-tab" role="tabpanel">
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h4 fw-bold mb-0">Tickets/Bookings</h2>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            Upcoming
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-menu-item dropdown-item" href="#">Upcoming</a></li>
                            <li><a class="dropdown-menu-item dropdown-item" href="#">Completed</a></li>
                        </ul>
                    </div>
                </div>

                
                <ul class="nav nav-tabs mb-3" id="bookingSubTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="flights-sub-tab" data-bs-toggle="tab" data-bs-target="#flights-list" type="button" role="tab">
                            <i class="fas fa-plane me-1"></i> Flights
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="stays-sub-tab" data-bs-toggle="tab" data-bs-target="#stays-list" type="button" role="tab">
                            <i class="fas fa-bed me-1"></i> Stays
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="bookingSubTabsContent">
                    
                    <div class="tab-pane fade show active" id="flights-list" role="tabpanel">
                        @if (Model.FlightBookings.Any())
                        {
                            @foreach (var booking in Model.FlightBookings)
                            {
                                <div class="card border mb-3 shadow-sm">
                                    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@booking.Flight?.Logo" alt="@booking.Flight?.Airline" class="rounded" width="50" height="50">
                                            <div>
                                                <div class="fw-bold fs-5">@booking.Flight?.From <i class="fas fa-arrow-right mx-1 small text-muted"></i> @booking.Flight?.To</div>
                                                <span class="text-muted small">@booking.Flight?.Departure - @booking.Flight?.Arrival</span>
                                            </div>
                                        </div>

                                        <div class="row g-2 text-center text-md-start small border-start border-end px-md-3">
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Date</span>
                                                <span class="fw-semibold">@booking.BookingDate.ToString("dd-MM-yy")</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Gate</span>
                                                <span class="fw-semibold">@booking.Gate</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Duration</span>
                                                <span class="fw-semibold">@booking.Flight?.Duration</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Seat</span>
                                                <span class="fw-semibold">@booking.Seat</span>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <a href="/Flights/Ticket/@booking.Id" class="btn btn-success btn-sm">Download Ticket</a>
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm border" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="/Flights/Details/@booking.FlightId"><i class="fas fa-info-circle me-2"></i>View Details</a></li>
                                                    <li><button class="dropdown-item text-danger btn-delete-booking-ajax" data-type="flight" data-id="@booking.Id"><i class="fas fa-trash-alt me-2"></i>Delete</button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <p class="mb-0">No flight bookings found.</p>
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="stays-list" role="tabpanel">
                        @if (Model.StayBookings.Any())
                        {
                            @foreach (var booking in Model.StayBookings)
                            {
                                <div class="card border mb-3 shadow-sm">
                                    <div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@booking.Hotel?.MainImage" alt="@booking.Hotel?.Name" class="rounded" width="50" height="50">
                                            <div>
                                                <div class="fw-bold fs-5">@booking.Hotel?.Name</div>
                                                <span class="text-muted small">@booking.RoomType</span>
                                            </div>
                                        </div>

                                        <div class="row g-2 text-center text-md-start small border-start border-end px-md-3">
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Check In</span>
                                                <span class="fw-semibold">@booking.CheckIn.ToString("dd-MM-yy")</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Nights</span>
                                                <span class="fw-semibold">@booking.Nights</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Check Out</span>
                                                <span class="fw-semibold">@booking.CheckOut.ToString("dd-MM-yy")</span>
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <span class="text-muted d-block">Booking ID</span>
                                                <span class="fw-semibold">#@booking.Id</span>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <a href="/Hotels/Ticket/@booking.Id" class="btn btn-success btn-sm">Download Ticket</a>
                                            <div class="dropdown">
                                                <button class="btn btn-light btn-sm border" type="button" data-bs-toggle="dropdown">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="/Hotels/Details/@booking.HotelId"><i class="fas fa-info-circle me-2"></i>View Details</a></li>
                                                    <li><button class="dropdown-item text-danger btn-delete-booking-ajax" data-type="stay" data-id="@booking.Id"><i class="fas fa-trash-alt me-2"></i>Delete</button></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <p class="mb-0">No stay bookings found.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade @(ViewBag.ActiveTab == "payments" ? "show active" : "")" id="payments-tab" role="tabpanel">
            <div class="card border-0 shadow-sm p-4">
                <h2 class="h4 fw-bold mb-4">Payment methods</h2>

                <div class="row g-3">
                    @if (Model.PaymentMethods.Any())
                    {
                        @foreach (var card in Model.PaymentMethods)
                        {
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card bg-success text-white border-0 shadow p-3 rounded-4">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div class="fs-5 fw-bold tracking-wide">
                                            **** **** **** @(card.CardNumber.Length > 4 ? card.CardNumber.Substring(card.CardNumber.Length - 4) : "4321")
                                        </div>
                                        <button class="btn btn-link text-white p-0 border-0 btn-delete-card"><i class="fas fa-trash-alt"></i></button>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <span class="d-block small text-white-50">Valid Thru</span>
                                            <span class="fw-semibold">@card.ExpiryDate</span>
                                        </div>
                                        <i class="fab fa-cc-visa fs-2"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card bg-success text-white border-0 shadow p-3 rounded-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="fs-5 fw-bold tracking-wide">**** **** **** 4321</div>
                                    <button class="btn btn-link text-white p-0 border-0 btn-delete-card"><i class="fas fa-trash-alt"></i></button>
                                </div>
                                <div class="d-flex justify-content-between align-items-end">
                                    <div>
                                        <span class="d-block small text-white-50">Valid Thru</span>
                                        <span class="fw-semibold">02/27</span>
                                    </div>
                                    <i class="fab fa-cc-visa fs-2"></i>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card border-2 border-dash text-center p-4 h-100 d-flex flex-column align-items-center justify-content-center role-button" 
                             data-bs-toggle="modal" data-bs-target="#addCardModal">
                            <div class="rounded-circle bg-light p-3 text-success mb-2">
                                <i class="fas fa-plus fs-4"></i>
                            </div>
                            <span class="fw-semibold text-muted">Add a new card</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="addCardModal" tabindex="-1" aria-labelledby="addCardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addCardModalLabel">Add a new Card</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="add-card-form" class="d-flex flex-column gap-3">
                    
                    <div class="form-group">
                        <label class="form-label small fw-semibold">Card Number</label>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="4321 4321 4321 4321" required>
                            <span class="input-group-text bg-white"><i class="fab fa-cc-visa fs-5 text-muted"></i></span>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Exp. Date</label>
                            <input type="text" class="form-control" placeholder="02/27" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">CVC</label>
                            <input type="text" class="form-control" placeholder="123" required>
                        </div>
                    </div>

                    <div>
                        <label class="form-label small fw-semibold">Name on Card</label>
                        <input type="text" class="form-control" placeholder="John Doe" required>
                    </div>

                    <div>
                        <label class="form-label small fw-semibold">Country or Region</label>
                        <select class="form-select">
                            <option>United States</option>
                            <option>Brazil</option>
                            <option>Canada</option>
                            <option>United Kingdom</option>
                        </select>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" checked id="saveInfoCheck">
                        <label class="form-check-label small" for="saveInfoCheck">
                            Securely save my information for 1-click checkout
                        </label>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Add Card</button>

                    <p class="text-muted text-center small mb-0" style="font-size: 0.75rem;">
                        By confirming your subscription, you allow The Outdoor Inn Crowd Limited to charge your card for this payment and future payments in accordance with their terms. You can always cancel your subscription.
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Account/account.js" asp-append-version="true"></script>
}
