@{
    Layout = null;
    ViewData["Title"] = "Password Reset Complete - Travel";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/Account/forgot-password.css" asp-append-version="true">
</head>
<body>
    <div class="login-container container-fluid p-0">
        <div class="row g-0 w-100 h-100">
            
            <div class="col-12 col-lg-5 login-left d-flex flex-column p-4 p-md-5">
                <div class="login-content mx-auto w-100">

                    <div class="d-flex align-items-center justify-content-end mb-5">
                        <div class="logo-area">
                            <span class="logo-text">
                                Travel <i class="fas fa-plane-departure"></i>
                            </span>
                        </div>
                    </div>

                    <div class="text-center my-auto py-4">
                        <div class="mb-4">
                            <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                        </div>

                        <h1 class="login-title mb-3">Password Changed!</h1>
                        <p class="login-subtitle mb-4">Your password has been successfully reset. You can now log in using your new credentials.</p>

                        <a href="@Url.Action("Login", "Account")" class="btn custom-btn w-100 fw-semibold text-decoration-none">
                            Back to Login
                        </a>
                    </div>

                </div>
            </div>

            <div class="col-lg-7 d-none d-lg-flex login-right align-items-center justify-content-center p-4">
                <div class="image-container-right">
                    <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=1200&h=1600&fit=crop" 
                         alt="Hotel Pool" 
                         class="w-100 h-100 object-fit-cover">
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
