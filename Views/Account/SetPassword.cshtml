@{
    Layout = null;
    ViewData["Title"] = "Set Password - Travel";
    var email = ViewData["Email"] as string;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/Account/forgot-password.css" asp-append-version="true">
</head>
<body>
    <div class="login-container container-fluid p-0">
        <div class="row g-0 w-100 h-100">
            
            <div class="col-12 col-lg-5 login-left d-flex flex-column p-4 p-md-5">
                <div class="login-content mx-auto w-100">

                    <div class="d-flex align-items-center justify-content-between mb-5">
                        <a href="@Url.Action("ForgotPassword", "Account")" class="back-link d-inline-flex align-items-center gap-2 text-decoration-none fw-medium" style="color: #4B5563;">
                            <i class="fas fa-chevron-left" style="color: #D97706;"></i> 
                            <span>Back</span>
                        </a>
                        
                        
                        <a asp-controller="Home" asp-action="Index" class="logo-area d-flex align-items-center gap-2 text-decoration-none">
                            <span class="logo-text fw-bold" style="color: #112211; font-size: 24px;">Travel</span>
                            <i class="fas fa-plane-departure" style="color: #8DD3BB; font-size: 20px;"></i>
                        </a>
                    </div>

                    <div class="mb-4">
                        <h1 class="login-title">Set a new password</h1>
                        <p class="login-subtitle">Create a new password for account <strong>@email</strong>.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                            <ul class="mb-0 ps-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form method="post" action="@Url.Action("SetPassword", "Account")" class="d-flex flex-column gap-3 login-form">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="email" value="@email" />

                        <div>
                            <label for="password" class="form-label custom-label">New Password*</label>
                            <div class="password-wrapper position-relative">
                                <input type="password" class="form-control custom-input pe-5" id="password" name="password" placeholder="Enter new password" required>
                                <button class="btn toggle-password" type="button" tabindex="-1">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div>
                            <label for="confirmPassword" class="form-label custom-label">Re-enter Password*</label>
                            <div class="password-wrapper position-relative">
                                <input type="password" class="form-control custom-input pe-5" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required>
                                <button class="btn toggle-password" type="button" tabindex="-1">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <button type="submit" class="btn custom-btn mt-2 fw-semibold">Reset Password</button>
                    </form>

                </div>
            </div>

            <div class="col-lg-7 d-none d-lg-flex login-right align-items-center justify-content-center p-4">
                <div class="image-container-right">
                    <img src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?w=1200&h=1600&fit=crop" 
                         alt="Hotel Pool" 
                         class="w-100 h-100 object-fit-cover">
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
</body>
</html>
