@{
    ViewData["Title"] = "Travel - Agência de Viagens";
    ViewData["BodyClass"] = "home-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Shared/home.css" asp-append-version="true">
}

<!-- Glassmorphism Background Blobs -->
<div class="bg-blobs">
    <div class="blob-1"></div>
    <div class="blob-2"></div>
    <div class="blob-3"></div>
</div>

<!-- Decorative grid of dots (top-right of Category) -->
<div class="decors-grid"></div>

<!-- 1. Hero Section -->
<section class="jadoo-hero">
    <div class="container">
        <div class="jadoo-hero-grid">
            <!-- Hero Left -->
            <div class="jadoo-hero-content">
                <p class="hero-tagline">Melhores destinos ao redor do mundo</p>
                <h1 class="hero-main-title">
                    Viaje, <span class="enjoy-highlight">aproveite</span> e viva uma vida nova e plena
                </h1>
                <p class="hero-desc">
                    Explore os destinos mais incríveis com conforto e segurança. Oferecemos pacotes exclusivos para você viver momentos inesquecíveis.
                </p>
                <div class="hero-actions">
                    <a href="/Flights" class="btn-find-out">Saiba mais</a>
                    <button class="btn-play-demo" id="btn-play-demo">
                        <span class="play-icon-wrapper">
                            <i class="fas fa-play"></i>
                        </span>
                        <span class="play-text">Ver Demonstração</span>
                    </button>
                </div>
            </div>
            
            <!-- Hero Right -->
            <div class="jadoo-hero-graphics">
                <div class="hero-bg-accent"></div>
                <img src="/images/uploads/hero_traveler.png" alt="Smiling Traveler sitting on suitcase" class="hero-main-img">
            </div>
        </div>
    </div>
</section>

<!-- 2. Services / Category Section -->
<section class="jadoo-services">
    <div class="container">
        <div class="jadoo-section-header">
            <h3 class="jadoo-section-subtitle">Categoria</h3>
            <h2 class="jadoo-section-title">Oferecemos os Melhores Serviços</h2>
        </div>
        
        <div class="services-grid services-grid-two">
            <!-- Card 1: Melhores Hotéis -->
            <div class="service-card">
                <div class="service-icon-container">
                    <i class="fas fa-hotel service-icon-fa" style="color: #4A90E2;"></i>
                </div>
                <h3 class="service-title">Melhores Hotéis</h3>
                <p class="service-desc">Encontre os melhores hotéis e acomodações incríveis para a sua estadia perfeita.</p>
            </div>

            <!-- Card 2: Melhores Voos -->
            <div class="service-card active-highlight">
                <div class="service-icon-container">
                    <i class="fas fa-plane service-icon-fa" style="color: #DF6951; transform: rotate(-15deg);"></i>
                </div>
                <h3 class="service-title">Melhores Voos</h3>
                <p class="service-desc">As melhores opções de voos com tarifas competitivas e horários flexíveis.</p>
            </div>
        </div>
    </div>
</section>

<!-- 3. Top Destinations Section -->
<section class="jadoo-destinations" id="destinations">
    <div class="container">
        <div class="jadoo-section-header">
            <h3 class="jadoo-section-subtitle">Mais Vendidos</h3>
            <h2 class="jadoo-section-title">Principais Destinos</h2>
        </div>
        
        <div class="destinations-grid">
            <!-- Dest 1: Roma -->
            <div class="dest-card">
                <div class="dest-img-container">
                    <img src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=600&q=80" alt="Roma, Itália">
                </div>
                <div class="dest-info-body">
                    <div class="dest-meta-row">
                        <span class="dest-title">Roma, Itália</span>
                        <span class="dest-price">R$ 5.420</span>
                    </div>
                    <div class="dest-duration-row">
                        <i class="fas fa-navigation"></i>
                        <span>Viagem de 10 dias</span>
                    </div>
                </div>
            </div>

            <!-- Dest 2: Londres -->
            <div class="dest-card">
                <div class="dest-img-container">
                    <img src="/images/Shared/londres.jpg" alt="Londres, Reino Unido">
                </div>
                <div class="dest-info-body">
                    <div class="dest-meta-row">
                        <span class="dest-title">Londres, Reino Unido</span>
                        <span class="dest-price">R$ 4.200</span>
                    </div>
                    <div class="dest-duration-row">
                        <i class="fas fa-navigation"></i>
                        <span>Viagem de 12 dias</span>
                    </div>
                </div>
            </div>

            <!-- Dest 3: Europa -->
            <div class="dest-card">
                <div class="dest-img-container">
                    <img src="https://images.unsplash.com/photo-1499856871958-5b9627545d1a?w=600&q=80" alt="Europa Completa">
                </div>
                <div class="dest-info-body">
                    <div class="dest-meta-row">
                        <span class="dest-title">Europa Completa</span>
                        <span class="dest-price">R$ 15.000</span>
                    </div>
                    <div class="dest-duration-row">
                        <i class="fas fa-navigation"></i>
                        <span>Viagem de 28 dias</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 4. Steps Section -->
<section class="jadoo-steps">
    <div class="container">
        <div class="steps-grid">
            <!-- Steps Left -->
            <div class="steps-left">
                <h3 class="jadoo-section-subtitle" style="text-align: left;">Fácil e Rápido</h3>
                <h2 class="jadoo-section-title" style="text-align: left; font-size: 44px; margin-bottom: 24px;">Reserve sua próxima viagem em 3 passos simples</h2>
                
                <div class="steps-list">
                    <!-- Step 1 -->
                    <div class="step-item">
                        <div class="step-icon-box step-icon-yellow">
                            <i class="fas fa-map-location-dot"></i>
                        </div>
                        <div class="step-info">
                            <h4>Escolha o Destino</h4>
                            <p>Selecione para onde você deseja ir e encontre as melhores opções.</p>
                        </div>
                    </div>
                    
                    <!-- Step 2 -->
                    <div class="step-item">
                        <div class="step-icon-box step-icon-orange">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div class="step-info">
                            <h4>Faça o Pagamento</h4>
                            <p>Realize o pagamento de forma simples, rápida e 100% segura.</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="step-item">
                        <div class="step-icon-box step-icon-teal">
                            <i class="fas fa-car"></i>
                        </div>
                        <div class="step-info">
                            <h4>Vá ao Aeroporto na Data Selecionada</h4>
                            <p>Chegue ao aeroporto no dia marcado e aproveite a sua viagem!</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Steps Right (Floating Mockups) -->
            <div class="steps-right">
                <!-- Greece Trip Card -->
                <div class="card-trip-greece">
                    <img src="https://images.unsplash.com/photo-1533105079780-92b9be482077?w=500&q=80" alt="Santorini, Grécia" class="greece-img">
                    <h3 class="greece-title">Viagem para a Grécia</h3>
                    <div class="greece-meta">
                        <span>14-29 de Junho</span>
                        <span>|</span>
                        <span>por Robbin Joseph</span>
                    </div>
                    <div class="greece-actions">
                        <span class="greece-circle-icon"><i class="fas fa-leaf"></i></span>
                        <span class="greece-circle-icon"><i class="fas fa-map"></i></span>
                        <span class="greece-circle-icon"><i class="fas fa-paper-plane"></i></span>
                    </div>
                    <div class="greece-footer">
                        <div class="greece-people">
                            <i class="fas fa-building-user"></i>
                            <span>24 pessoas inscritas</span>
                        </div>
                        <i class="far fa-heart greece-heart" id="greece-heart-btn"></i>
                    </div>
                </div>

                <!-- Overlapping Ongoing Card -->
                <div class="card-ongoing-rome">
                    <div class="rome-avatar-container">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80" alt="Viajante">
                    </div>
                    <div class="rome-info">
                        <p class="rome-status">Em andamento</p>
                        <h4 class="rome-title">Viagem para Roma</h4>
                        <div class="rome-progress-meta">
                            <span>40%</span> concluído
                        </div>
                        <div class="rome-progress-bg">
                            <div class="rome-progress-fill"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 5. Testimonials Section -->
<section class="jadoo-testimonials">
    <div class="container">
        <div class="testimonials-grid">
            <!-- Left Header & Dots -->
            <div class="testimonials-left">
                <div>
                    <h3 class="jadoo-section-subtitle" style="text-align: left;">Depoimentos</h3>
                    <h2 class="jadoo-section-title" style="text-align: left; font-size: 50px;">O que as pessoas dizem sobre nós.</h2>
                </div>
                <div class="testimonial-dots">
                    <span class="dot active" data-index="0"></span>
                    <span class="dot" data-index="1"></span>
                </div>
            </div>
            
            <!-- Right Stack -->
            <div class="testimonials-right">
                <div class="testimonial-stack" id="testimonial-stack-container">
                    <!-- Testimonial 1 -->
                    <div class="testimonial-card active" data-index="0">
                        <div class="avatar-wrapper">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&q=80" alt="Mike Taylor">
                        </div>
                        <p class="quote-text">
                            "A experiência de reservar com a Travel foi simplesmente incrível. Tudo muito organizado e sem complicações!"
                        </p>
                        <h4 class="author-name">Mike Taylor</h4>
                        <p class="author-location">Lahore, Paquistão</p>
                    </div>

                    <!-- Testimonial 2 -->
                    <div class="testimonial-card next" data-index="1">
                        <div class="avatar-wrapper">
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&q=80" alt="Chris Thomas">
                        </div>
                        <p class="quote-text">
                            "As opções de voos e hotéis são excelentes, com preços super competitivos. Com certeza reservarei novamente."
                        </p>
                        <h4 class="author-name">Chris Thomas</h4>
                        <p class="author-location">CEO da Red Button</p>
                    </div>
                </div>
                
                <!-- Nav Arrows -->
                <div class="testimonials-nav">
                    <button class="nav-arrow" id="testimonial-prev-btn"><i class="fas fa-chevron-up"></i></button>
                    <button class="nav-arrow" id="testimonial-next-btn"><i class="fas fa-chevron-down"></i></button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 6. Brands Section -->
<section class="jadoo-brands">
    <div class="container">
        <div class="brands-row">
            <img src="/images/uploads/logos.png" alt="Marcas Parceiras" class="brands-logos-img">
        </div>
    </div>
</section>

<!-- 7. Subscribe Section -->
<section class="jadoo-subscribe">
    <div class="container">
        <div class="subscribe-card">
            <!-- Plus signs accent -->
            <div class="plus-sign-grid"></div>
            
            <!-- Floating Plane Icon -->
            <div class="subscribe-plane-container">
                <i class="fas fa-paper-plane"></i>
            </div>
            
            <h2 class="subscribe-title">
                Inscreva-se para receber informações, últimas notícias e ofertas exclusivas sobre a Travel
            </h2>
            
            <form class="subscribe-form" id="subscribe-form">
                <div class="subscribe-input-wrapper">
                    <i class="far fa-envelope"></i>
                    <input type="email" placeholder="Seu e-mail" class="subscribe-input" id="subscribe-email" required>
                </div>
                <button type="submit" class="btn-subscribe">Inscrever-se</button>
            </form>
        </div>
    </div>
</section>

<!-- Video Lightbox Modal (For Play Demo) -->
<div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: transparent; border: none;">
            <div class="modal-body p-0 position-relative">
                <button type="button" class="btn-close btn-close-white position-absolute" data-bs-dismiss="modal" aria-label="Close" style="top: -30px; right: 0;"></button>
                <div class="ratio ratio-16x9">
                    <iframe id="videoIframe" src="" title="Travel Showcase Video" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Shared/home.js" asp-append-version="true"></script>
}
