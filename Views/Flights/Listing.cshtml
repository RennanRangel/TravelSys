@model ProjetoHotelAviao.Models.PaginatedList<ProjetoHotelAviao.Models.Flight>
@using System.Linq
@{
    ViewData["Title"] = "Voos - Travel";
    var currentSort = ViewData["CurrentSort"] as string ?? "cheapest";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Flights/flights-listing.css" asp-append-version="true">
}

<div class="listing-page">

    
    <div class="category-tabs-bar">
        <div class="category-tabs-scroll">
            <a href="#" onclick="applySort('cheapest'); return false;" class="cat-tab @(currentSort == "cheapest" ? "active" : "")">
                <i class="fas fa-tag"></i>
                <span>Mais Baratos</span>
            </a>
            <a href="#" onclick="applySort('best'); return false;" class="cat-tab @(currentSort == "best" ? "active" : "")">
                <i class="fas fa-star"></i>
                <span>Melhor Opção</span>
            </a>
            <a href="#" onclick="applySort('quickest'); return false;" class="cat-tab @(currentSort == "quickest" ? "active" : "")">
                <i class="fas fa-bolt"></i>
                <span>Mais Rápidos</span>
            </a>
            <a href="#" class="cat-tab">
                <i class="fas fa-exchange-alt"></i>
                <span>Ida e Volta</span>
            </a>
            <a href="#" class="cat-tab">
                <i class="fas fa-plane"></i>
                <span>Só Ida</span>
            </a>
        </div>
        <div class="filter-pills">
            <button class="filter-pill" id="btnToggleFilters">
                <i class="fas fa-sliders-h"></i> Filtros
            </button>
            <div class="price-display-toggle">
                <span>Exibir preço total</span>
                <label class="toggle-switch">
                    <input type="checkbox" id="totalPriceToggle">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    
    <div class="listing-layout">

        
        <aside class="listing-sidebar" id="listingSidebar">
            <h3 class="sidebar-title">Filtros</h3>
            <form asp-action="Listing" method="get" id="filterForm">
                @if (ViewData["SearchRoute"] != null)
                {
                    <input type="hidden" name="route" value="@ViewData["SearchRoute"]" />
                }
                <input type="hidden" name="sortOrder" id="sortOrderInput" value="@currentSort" />

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Preço</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        <div class="price-range">
                            <input type="range" name="minPrice" min="50" max="1200" value="@(ViewData["MinPrice"] ?? 50)" class="range-slider">
                            <input type="range" name="maxPrice" min="50" max="1200" value="@(ViewData["MaxPrice"] ?? 1200)" class="range-slider">
                        </div>
                        <div class="price-labels">
                            <span>$@(ViewData["MinPrice"] ?? 50)</span>
                            <span>$@(ViewData["MaxPrice"] ?? 1200)</span>
                        </div>
                    </div>
                </div>

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Horário de Partida</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        <div class="price-range">
                            <input type="range" name="minTime" min="0" max="24" value="@(ViewData["MinTime"] ?? 0)" class="range-slider">
                            <input type="range" name="maxTime" min="0" max="24" value="@(ViewData["MaxTime"] ?? 24)" class="range-slider">
                        </div>
                        <div class="price-labels">
                            <span>00:00</span>
                            <span>23:59</span>
                        </div>
                    </div>
                </div>

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Companhias Aéreas</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        @{
                            var selectedAirlines = ViewData["SelectedAirlines"] as string[] ?? new string[0];
                        }
                        <label class="checkbox-option">
                            <input type="checkbox" name="airlines" value="Emirates" @(selectedAirlines.Contains("Emirates") ? "checked" : "")>
                            <span>Emirates</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="airlines" value="Fly Dubai" @(selectedAirlines.Contains("Fly Dubai") ? "checked" : "")>
                            <span>Fly Dubai</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="airlines" value="Qatar" @(selectedAirlines.Contains("Qatar") ? "checked" : "")>
                            <span>Qatar Airways</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="airlines" value="Etihad" @(selectedAirlines.Contains("Etihad") ? "checked" : "")>
                            <span>Etihad Airways</span>
                        </label>
                    </div>
                </div>

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Tipo de Viagem</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        @{
                            var selectedTripTypes = ViewData["SelectedTripTypes"] as string[] ?? new string[0];
                        }
                        <label class="checkbox-option">
                            <input type="checkbox" name="tripType" value="Round trip" @(selectedTripTypes.Contains("Round trip") ? "checked" : "")>
                            <span>Ida e Volta</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="tripType" value="One Way" @(selectedTripTypes.Contains("One Way") ? "checked" : "")>
                            <span>Só Ida</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="tripType" value="Multi-City" @(selectedTripTypes.Contains("Multi-City") ? "checked" : "")>
                            <span>Multi-destino</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-apply-filters">Aplicar Filtros</button>
            </form>
        </aside>

        
        <main class="listing-main">

            
            <div class="listing-search-bar">
                <form asp-action="Listing" method="get" class="listing-search-form">
                    <div class="search-field">
                        <i class="fas fa-exchange-alt"></i>
                        <input type="text" name="route" value="@ViewData["SearchRoute"]" placeholder="Origem - Destino" list="city-list">
                        <datalist id="city-list">
                            @if (ViewData["AvailableCities"] is List<string> cities)
                            {
                                foreach (var city in cities)
                                {
                                    <option value="@city"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-random"></i>
                        <select name="tripType" class="search-select">
                            @{
                                var selTrips = ViewData["SelectedTripTypes"] as string[] ?? new string[0];
                            }
                            <option value="">Qualquer tipo</option>
                            <option value="Round trip" selected="@(selTrips.Contains("Round trip"))">Ida e Volta</option>
                            <option value="One Way" selected="@(selTrips.Contains("One Way"))">Só Ida</option>
                            <option value="Multi-City" selected="@(selTrips.Contains("Multi-City"))">Multi-destino</option>
                        </select>
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" name="dates" placeholder="Datas">
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-user-friends"></i>
                        <input type="text" name="passengers" placeholder="Passageiros e classe">
                    </div>
                    <button type="submit" class="btn-search-listing">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
            </div>

            
            <div class="results-info">
                <p><span>@Model.Count()</span> voos encontrados</p>
            </div>

            
            <form id="filterFormHidden" asp-action="Listing" method="get" style="display:none;">
                <input type="hidden" name="sortOrder" id="sortOrderInputHidden" value="@currentSort" />
                @if (ViewData["SearchRoute"] != null) { <input type="hidden" name="route" value="@ViewData["SearchRoute"]" /> }
                @if (ViewData["MinPrice"] != null) { <input type="hidden" name="minPrice" value="@ViewData["MinPrice"]" /> }
                @if (ViewData["MaxPrice"] != null) { <input type="hidden" name="maxPrice" value="@ViewData["MaxPrice"]" /> }
                @foreach (var a in (string[])(ViewData["SelectedAirlines"] ?? new string[0]))
                {
                    <input type="hidden" name="airlines" value="@a" />
                }
                @foreach (var t in (string[])(ViewData["SelectedTripTypes"] ?? new string[0]))
                {
                    <input type="hidden" name="tripType" value="@t" />
                }
            </form>

            
            <div class="flight-cards-list">
                @if (!Model.Any())
                {
                    <div class="no-results">
                        <i class="fas fa-plane fa-3x"></i>
                        <p>Nenhum voo encontrado para "@ViewData["SearchRoute"]".</p>
                        <a href="/Flights" class="btn-back">Voltar para Voos</a>
                    </div>
                }

                @{ var cardIndex = 0; }
                @foreach (var flight in Model)
                {
                    var cid = $"card-{cardIndex}";
                    <div class="flight-card" id="@cid">
                        
                        <div class="flight-card-airline">
                            @if (!string.IsNullOrEmpty(flight.Logo))
                            {
                                <img src="@flight.Logo" alt="@flight.Airline" class="airline-logo">
                            }
                            else
                            {
                                <div class="airline-logo-placeholder"><i class="fas fa-plane"></i></div>
                            }
                            <span class="airline-name">@flight.Airline</span>
                        </div>

                        
                        <div class="flight-card-body">
                            
                            <div class="flight-leg">
                                <div class="leg-time">
                                    <span class="time-bold">@flight.Departure</span>
                                    <span class="iata-code">@flight.From</span>
                                </div>
                                <div class="leg-line">
                                    <span class="stop-badge">@flight.Stops</span>
                                    <div class="flight-line">
                                        <div class="line-dot"></div>
                                        <div class="line-bar"></div>
                                        <i class="fas fa-plane line-plane"></i>
                                        <div class="line-bar"></div>
                                        <div class="line-dot"></div>
                                    </div>
                                    <span class="duration-badge">@flight.Duration</span>
                                </div>
                                <div class="leg-time leg-time-right">
                                    <span class="time-bold">@flight.Arrival</span>
                                    <span class="iata-code">@flight.To</span>
                                </div>
                            </div>

                            
                            @if (flight.TripType == "Round trip")
                            {
                                <div class="flight-leg flight-leg-return">
                                    <div class="leg-time">
                                        <span class="time-bold">@flight.Arrival</span>
                                        <span class="iata-code">@flight.To</span>
                                    </div>
                                    <div class="leg-line">
                                        <span class="stop-badge">@flight.Stops</span>
                                        <div class="flight-line">
                                            <div class="line-dot"></div>
                                            <div class="line-bar"></div>
                                            <i class="fas fa-plane line-plane line-plane-return"></i>
                                            <div class="line-bar"></div>
                                            <div class="line-dot"></div>
                                        </div>
                                        <span class="duration-badge">@flight.Duration</span>
                                    </div>
                                    <div class="leg-time leg-time-right">
                                        <span class="time-bold">@flight.Departure</span>
                                        <span class="iata-code">@flight.From</span>
                                    </div>
                                </div>
                            }
                        </div>

                        
                        <div class="flight-card-actions">
                            <div class="price-block">
                                <span class="price-hint">a partir de</span>
                                <span class="price-value">R$ @flight.Price.ToString("N2")</span>
                                <span class="price-person">por pessoa</span>
                            </div>
                            <div class="action-buttons">
                                <button class="btn-heart-flight" onclick="event.stopPropagation();" title="Salvar">
                                    <i class="far fa-heart"></i>
                                </button>
                                <a href="/Flights/Details/@flight.Id?ida=true&volta=false" class="btn-view-flight">
                                    Ver Voo
                                </a>
                            </div>
                        </div>
                    </div>
                    cardIndex++;
                }
            </div>

            
            <div class="pagination-container">
                @{
                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";

                    string GetPaginationUrl(int page)
                    {
                        var query = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value);
                        query["pageNumber"] = page.ToString();
                        var queryString = string.Join("&", query.SelectMany(kvp => kvp.Value.Select(v => $"{kvp.Key}={System.Net.WebUtility.UrlEncode(v)}")));
                        return Url.Action("Listing") + "?" + queryString;
                    }
                }
                <a href="@GetPaginationUrl(Model.PageIndex - 1)" class="page-btn @prevDisabled">
                    <i class="fas fa-chevron-left"></i>
                </a>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var activeClass = i == Model.PageIndex ? "active" : "";
                    <a href="@GetPaginationUrl(i)" class="page-btn @activeClass">@i</a>
                }
                <a href="@GetPaginationUrl(Model.PageIndex + 1)" class="page-btn @nextDisabled">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>

        </main>
    </div>
</div>

@section Scripts {
    <script src="~/js/Flights/flights-listing.js"></script>
    <script>
        document.getElementById('btnToggleFilters')?.addEventListener('click', function () {
            document.getElementById('listingSidebar').classList.toggle('open');
        });
        function applySort(sort) {
            document.getElementById('sortOrderInputHidden').value = sort;
            document.getElementById('filterFormHidden').submit();
        }
    </script>
}
