@model ProjetoHotelAviao.Models.AdminTask
@{
    var priorityBadge = Model.Priority switch
    {
        "alta" => "bg-danger",
        "urgente" => "bg-warning text-dark",
        "media" => "bg-info text-dark",
        _ => "bg-secondary"
    };
    var priorityLabel = Model.Priority switch
    {
        "alta" => "Alta Prioridade",
        "urgente" => "Urgente",
        "media" => "Média",
        _ => "Baixa"
    };
    var isCompleted = Model.Status == "concluido";
}

<div class="card shadow-sm border-0 mb-3 task-card @(isCompleted ? "opacity-75 bg-light" : "bg-white")" data-task-id="@Model.Id">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge @priorityBadge fw-semibold">@priorityLabel</span>
            <div class="dropdown">
                <button class="btn btn-link text-muted p-0 border-0 shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-ellipsis-h"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    @if (Model.Status != "afazer")
                    {
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="moveTask(@Model.Id, 'afazer')">
                                <i class="fas fa-arrow-left text-muted me-2"></i>Mover para A Fazer
                            </a>
                        </li>
                    }
                    @if (Model.Status != "andamento")
                    {
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="moveTask(@Model.Id, 'andamento')">
                                <i class="fas fa-play text-primary me-2"></i>Mover para Em Andamento
                            </a>
                        </li>
                    }
                    @if (Model.Status != "concluido")
                    {
                        <li>
                            <a class="dropdown-item py-2" href="javascript:void(0)" onclick="moveTask(@Model.Id, 'concluido')">
                                <i class="fas fa-check text-success me-2"></i>Marcar como Concluído
                            </a>
                        </li>
                    }
                    <li><hr class="dropdown-divider my-1"></li>
                    <li>
                        <a class="dropdown-item text-danger py-2" href="javascript:void(0)" onclick="deleteTask(@Model.Id)">
                            <i class="fas fa-trash me-2"></i>Excluir
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <h6 class="card-title fw-bold mb-1 @(isCompleted ? "text-decoration-line-through text-muted" : "text-dark")">
            @Model.Title
        </h6>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="card-text small mb-3 @(isCompleted ? "text-decoration-line-through text-muted" : "text-secondary")">
                @Model.Description
            </p>
        }

        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
            <span class="small text-muted">
                @if (isCompleted && Model.CompletedAt.HasValue)
                {
                    <i class="fas fa-check-circle text-success me-1"></i>
                    <span>@Model.CompletedAt.Value.ToString("dd MMM")</span>
                }
                else
                {
                    <i class="fas fa-calendar-alt me-1"></i>
                    <span>@Model.CreatedAt.ToString("dd MMM")</span>
                }
            </span>
        </div>
    </div>
</div>