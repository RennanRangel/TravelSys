@model ProjetoHotelAviao.Models.PaginatedList<ProjetoHotelAviao.Models.Hotel>
@using System.Linq
@{
    ViewData["Title"] = "Hotéis - Travel";
    var currentType = ViewData["CurrentType"] as string;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Hotels/hotel-listing.css" asp-append-version="true">
}

<div class="listing-page">

    
    <div class="category-tabs-bar">
        <div class="category-tabs-scroll">
            <a href="#" onclick="applyPropertyType('Hotel'); return false;" class="cat-tab @(currentType == "Hotel" ? "active" : "")">
                <i class="fas fa-hotel"></i>
                <span>Hotéis</span>
            </a>
            <a href="#" onclick="applyPropertyType('Resort'); return false;" class="cat-tab @(currentType == "Resort" ? "active" : "")">
                <i class="fas fa-umbrella-beach"></i>
                <span>Resorts</span>
            </a>
            <a href="#" onclick="applyPropertyType('Motel'); return false;" class="cat-tab @(currentType == "Motel" ? "active" : "")">
                <i class="fas fa-bed"></i>
                <span>Motéis</span>
            </a>
            <a href="#" onclick="applyPropertyType('Apartment'); return false;" class="cat-tab @(currentType == "Apartment" ? "active" : "")">
                <i class="fas fa-building"></i>
                <span>Apartamentos</span>
            </a>
            <a href="#" onclick="applyPropertyType('Villa'); return false;" class="cat-tab @(currentType == "Villa" ? "active" : "")">
                <i class="fas fa-home"></i>
                <span>Villas</span>
            </a>
        </div>
        <div class="filter-pills">
            <button class="filter-pill" id="btnToggleFilters">
                <i class="fas fa-sliders-h"></i> Filtros
            </button>
            <div class="price-display-toggle">
                <span>Exibir preço total</span>
                <label class="toggle-switch">
                    <input type="checkbox" id="totalPriceToggle">
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    
    <div class="listing-layout">

        
        <aside class="listing-sidebar" id="listingSidebar">
            <h3 class="sidebar-title">Filtros</h3>
            <form asp-action="Listing" method="get" id="filterForm">
                @if (ViewData["CurrentLocation"] != null)
                {
                    <input type="hidden" name="location" value="@ViewData["CurrentLocation"]" />
                }
                <input type="hidden" name="propertyType" id="propertyTypeInput" value="@currentType" />

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Preço por noite</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        <div class="price-range">
                            <input type="range" name="minPrice" min="50" max="1200" value="@(ViewData["MinPrice"] ?? 50)" class="range-slider">
                            <input type="range" name="maxPrice" min="50" max="1200" value="@(ViewData["MaxPrice"] ?? 1200)" class="range-slider">
                        </div>
                        <div class="price-labels">
                            <span>$@(ViewData["MinPrice"] ?? 50)</span>
                            <span>$@(ViewData["MaxPrice"] ?? 1200)</span>
                        </div>
                    </div>
                </div>

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Benefícios</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        @{
                            var selectedFreebies = ViewData["SelectedFreebies"] as string[] ?? new string[0];
                        }
                        <label class="checkbox-option">
                            <input type="checkbox" name="freebies" value="Free breakfast" @(selectedFreebies.Contains("Free breakfast") ? "checked" : "")>
                            <span>Café da manhã grátis</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="freebies" value="Free parking" @(selectedFreebies.Contains("Free parking") ? "checked" : "")>
                            <span>Estacionamento grátis</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="freebies" value="Free internet" @(selectedFreebies.Contains("Free internet") ? "checked" : "")>
                            <span>Wi-Fi grátis</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="freebies" value="Free cancellation" @(selectedFreebies.Contains("Free cancellation") ? "checked" : "")>
                            <span>Cancelamento grátis</span>
                        </label>
                    </div>
                </div>

                
                <div class="filter-section">
                    <div class="filter-header">
                        <h4>Comodidades</h4>
                        <i class="fas fa-chevron-up"></i>
                    </div>
                    <div class="filter-content">
                        @{
                            var selectedAmenities = ViewData["SelectedAmenities"] as string[] ?? new string[0];
                        }
                        <label class="checkbox-option">
                            <input type="checkbox" name="amenities" value="24hr front desk" @(selectedAmenities.Contains("24hr front desk") ? "checked" : "")>
                            <span>Recepção 24h</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="amenities" value="Air-conditioned" @(selectedAmenities.Contains("Air-conditioned") ? "checked" : "")>
                            <span>Ar-condicionado</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="amenities" value="Fitness" @(selectedAmenities.Contains("Fitness") ? "checked" : "")>
                            <span>Academia</span>
                        </label>
                        <label class="checkbox-option">
                            <input type="checkbox" name="amenities" value="Pool" @(selectedAmenities.Contains("Pool") ? "checked" : "")>
                            <span>Piscina</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn-apply-filters">Aplicar Filtros</button>
            </form>
        </aside>

        
        <main class="listing-main">

            
            <div class="listing-search-bar">
                <form asp-action="Listing" method="get" class="listing-search-form">
                    <div class="search-field">
                        <i class="fas fa-bed"></i>
                        <input type="text" name="location" value="@ViewData["CurrentLocation"]" placeholder="Destino" list="location-list">
                        <datalist id="location-list">
                            @if (ViewData["AvailableLocations"] is List<string> locations)
                            {
                                foreach (var loc in locations)
                                {
                                    <option value="@loc"></option>
                                }
                            }
                        </datalist>
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" name="checkIn" placeholder="Check-in" onfocus="(this.type='date')" onblur="(this.type='text')">
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" name="checkOut" placeholder="Check-out" onfocus="(this.type='date')" onblur="(this.type='text')">
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-field">
                        <i class="fas fa-user-friends"></i>
                        <input type="text" name="guests" placeholder="Hóspedes">
                    </div>
                    <button type="submit" class="btn-search-listing">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
            </div>

            
            <div class="results-info">
                <p><span>@Model.Count()</span> propriedades encontradas</p>
            </div>

            
            <div class="property-grid">
                @if (!Model.Any())
                {
                    <div class="no-results">
                        <i class="fas fa-search fa-3x"></i>
                        <p>Nenhum hotel encontrado. Tente outros critérios de busca.</p>
                        <a href="/Hotels" class="btn-back">Voltar para Hotéis</a>
                    </div>
                }

                @foreach (var hotel in Model)
                {
                    <div class="property-card" onclick="window.location.href='@Url.Action("Details", "Hotels", new { id = hotel.Id })'">
                        
                        <div class="property-img-wrap">
                            @if (!string.IsNullOrEmpty(hotel.MainImage))
                            {
                                <img src="@hotel.MainImage" alt="@hotel.Name" loading="lazy">
                            }
                            else
                            {
                                <div class="property-img-placeholder">
                                    <i class="fas fa-hotel"></i>
                                </div>
                            }
                            
                            <button class="btn-heart" onclick="event.stopPropagation();" title="Salvar">
                                <i class="far fa-heart"></i>
                            </button>
                            @if (hotel.IsAccessible)
                            {
                                <span class="badge-accessible"><i class="fas fa-wheelchair"></i></span>
                            }
                        </div>

                        
                        <div class="property-info">
                            <div class="property-top-row">
                                <h3 class="property-location">@hotel.Location</h3>
                                <div class="property-rating">
                                    <i class="fas fa-star"></i>
                                    <span>@(hotel.Rating > 0 ? hotel.Rating.ToString("F1") : "Novo")</span>
                                </div>
                            </div>
                            <p class="property-name">@hotel.Name</p>
                            <p class="property-type">@(hotel.Type ?? "Hotel")</p>
                            <div class="property-price-row">
                                <span class="property-price"><strong>$@hotel.Price</strong> / noite</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            
            <div class="pagination-container">
                @{
                    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
                    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
                }
                <a asp-action="Listing"
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   asp-route-location="@ViewData["CurrentLocation"]"
                   class="page-btn @prevDisabled">
                    <i class="fas fa-chevron-left"></i>
                </a>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    var activeClass = i == Model.PageIndex ? "active" : "";
                    <a asp-action="Listing"
                       asp-route-pageNumber="@i"
                       asp-route-location="@ViewData["CurrentLocation"]"
                       class="page-btn @activeClass">@i</a>
                }

                <a asp-action="Listing"
                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                   asp-route-location="@ViewData["CurrentLocation"]"
                   class="page-btn @nextDisabled">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </div>

        </main>
    </div>
</div>

@section Scripts {
    <script src="~/js/Hotels/hotel-listing.js"></script>
    <script>
        // Toggle sidebar
        document.getElementById('btnToggleFilters')?.addEventListener('click', function () {
            document.getElementById('listingSidebar').classList.toggle('open');
        });
    </script>
}
